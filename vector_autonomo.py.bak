# ----------------------- MEMORIA JSON -----------------------

def ahora_iso():
    return datetime.now().isoformat(timespec="seconds")


def memoria_inicial():
    return {
        "version": 1,
        "perfil": {
            "nombre_robot": "Vector",
            "personalidad": "curioso, carinoso y jugueton",
            "primer_inicio": ahora_iso(),
        },
        "estadisticas": {
            "sesiones": 0,
            "caricias": 0,
            "caricias_largas": 0,
            "caras_saludadas": 0,
            "exploraciones": 0,
            "juegos_cubo": 0,
            "dockings_cubo": 0,
            "obstaculos": 0,
            "bordes": 0,
            "levantado": 0,
            "sacudidas": 0,
            "descansos": 0,
            "objetos_vistos": 0,
            "analisis_visual": 0,
            "animales_vistos": 0,
            "personas_vistas_ia": 0,
        },
        "personas": {},
        "vision": {"ultima_descripcion": "", "ultimo_tipo": "", "ultima_fecha": ""},
        "recuerdos": [],
    }


def asegurar_estructura(memoria):
    base = memoria_inicial()

    memoria.setdefault("version", 1)
    memoria.setdefault("perfil", base["perfil"])
    memoria.setdefault("estadisticas", {})
    memoria.setdefault("personas", {})
    memoria.setdefault("vision", {"ultima_descripcion": "", "ultimo_tipo": "", "ultima_fecha": ""})
    memoria.setdefault("recuerdos", [])

    for clave, valor in base["estadisticas"].items():
        memoria["estadisticas"].setdefault(clave, valor)

    return memoria


def cargar_memoria():
    try:
        if ARCHIVO_MEMORIA.exists():
            with ARCHIVO_MEMORIA.open("r", encoding="utf-8") as archivo:
                memoria = json.load(archivo)

            if isinstance(memoria, dict):
                print("Memoria cargada:", ARCHIVO_MEMORIA)
                return asegurar_estructura(memoria)

    except Exception as error:
        print("Memoria no disponible; se iniciara una nueva:", error)

    return memoria_inicial()


def guardar_memoria(memoria):
    try:
        memoria = asegurar_estructura(memoria)
        temporal = ARCHIVO_MEMORIA.with_suffix(".tmp")

        with temporal.open("w", encoding="utf-8") as archivo:
            json.dump(memoria, archivo, ensure_ascii=False, indent=2)

        temporal.replace(ARCHIVO_MEMORIA)
        return True

    except Exception as error:
        print("No se pudo guardar memoria:", error)
        return False


def sumar_estadistica(memoria, clave, cantidad=1):
    estadisticas = memoria.setdefault("estadisticas", {})
    estadisticas[clave] = int(estadisticas.get(clave, 0)) + cantidad


def recordar(memoria, tipo, detalle):
    memoria.setdefault("recuerdos", []).append({
        "fecha": ahora_iso(),
        "tipo": str(tipo)[:40],
        "detalle": str(detalle)[:180],
    })

    memoria["recuerdos"] = memoria["recuerdos"][-MAX_RECUERDOS:]


def recordar_y_guardar(memoria, tipo, detalle, estadistica=None):
    if estadistica:
        sumar_estadistica(memoria, estadistica)

    recordar(memoria, tipo, detalle)
    guardar_memoria(memoria)


def registrar_persona(memoria, cara):
    try:
        face_id = str(cara.face_id)
    except Exception:
        return {"nombre": "alguien", "veces_vista": 0}

    personas = memoria.setdefault("personas", {})
    nombre_detectado = getattr(cara, "name", None) or "Desconocido"

    persona = personas.setdefault(face_id, {
        "nombre": nombre_detectado,
        "veces_vista": 0,
        "primera_vez": ahora_iso(),
        "ultima_vez": ahora_iso(),
    })

    if getattr(cara, "name", None):
        persona["nombre"] = cara.name

    persona["veces_vista"] = int(persona.get("veces_vista", 0)) + 1
    persona["ultima_vez"] = ahora_iso()

    return persona


# ------------------------ VOZ E IA --------------------------

def decir(robot, texto):
    try:
        texto = str(texto).strip()[:100]

        if not texto:
            return False

        print("Vector:", texto)

        robot.behavior.say_text(
            texto,
            use_vector_voice=True,
            duration_scalar=0.78,
        )
        return True

    except Exception as error:
        print("Voz omitida:", error)
        return False


def animar(robot, categoria):
    try:
        nombre = random.choice(ANIMACIONES.get(categoria, []))

        if nombre:
            robot.anim.play_animation(nombre, ignore_body_track=False)

    except Exception:
        pass


def frase_ia(evento):
    contexto = {
        "explorar": "Vector acaba de explorar con cuidado una habitacion",
        "persona": "Vector ha visto a una persona conocida",
        "persona_nueva": "Vector ha visto una persona nueva",
        "caricia": "Han acariciado a Vector con carino",
        "cubo": "Vector quiere jugar con su cubo",
        "docking": "Vector esta tocando su cubo con el gancho",
        "obstaculo": "Vector ha encontrado algo en su camino",
        "descanso": "Vector esta descansando y observando",
        "borde": "Vector ha detectado un borde peligroso",
    }

    if not USAR_IA_TEXTO or client is None:
        return random.choice(FRASES["ia_respaldo"])

    try:
        respuesta = client.chat.completions.create(
            model=MODELO_IA_TEXTO,
            messages=[
                {
                    "role": "system",
                    "content": (
                        "Eres Vector, una mascota robot pequena, carinosa, "
                        "curiosa y juguetona. Habla en espanol. Devuelve solo "
                        "una frase amable de maximo ocho palabras. "
                        "Sin emojis, sin comillas y sin explicaciones."
                    ),
                },
                {
                    "role": "user",
                    "content": contexto.get(evento, "Vector esta contento"),
                },
            ],
            max_tokens=32,
            temperature=1.0,
            timeout=20,
        )

        texto = respuesta.choices[0].message.content

        if texto and texto.strip():
            return texto.strip()

    except Exception as error:
        print("IA omitida:", error)

    return random.choice(FRASES["ia_respaldo"])


def lanzar_ia(evento, resultados, ia_ocupada):
    if not USAR_IA_TEXTO or client is None or ia_ocupada.is_set():
        return

    ia_ocupada.set()

    def tarea():
        try:
            resultados.put(frase_ia(evento))
        finally:
            ia_ocupada.clear()

    threading.Thread(target=tarea, daemon=True).start()




# --------------------- VISION CON IA -------------------------
def capturar_imagen_base64(robot):
    """Obtiene el objeto CameraImage del SDK y extrae su imagen Pillow."""
    try:
        imagen_camera = robot.camera.latest_image

        if imagen_camera is None:
            print("Vision: aun no hay una imagen disponible.")
            return None

        imagen = imagen_camera.raw_image.copy().convert("RGB")
        imagen.thumbnail((MAX_IMAGEN_LADO_PX, MAX_IMAGEN_LADO_PX))

        buffer = io.BytesIO()
        imagen.save(buffer, format="JPEG", quality=72, optimize=True)
        return base64.b64encode(buffer.getvalue()).decode("ascii")

    except Exception as error:
        print("Vision: no se pudo obtener imagen:", error)
        return None

def clasificar_descripcion_visual(descripcion):
    texto = descripcion.lower()
    if any(x in texto for x in ("perro", "gato", "pajaro", "ave", "animal", "mascota", "conejo", "caballo", "pez")):
        return "animal"
    if any(x in texto for x in ("persona", "hombre", "mujer", "nino", "niña", "rostro", "cara", "gente")):
        return "persona"
    return "objeto"

def analizar_imagen_ia(imagen_b64, memoria):
    if not USAR_IA_VISION or client is None or not imagen_b64:
        return None
    try:
        respuesta = client.chat.completions.create(
            model=MODELO_IA_VISION,
            messages=[
                {"role": "system", "content": "Eres el sistema visual de Vector. Describe solo lo visible con claridad. Responde en espanol, una frase de maximo doce palabras. No inventes objetos, animales, identidades, edades, emociones ni nombres. Si no estas seguro di: No distingo nada claro."},
                {"role": "user", "content": [
                    {"type": "text", "text": "Describe objetos, animales o personas visibles. No identifiques a nadie por nombre."},
                    {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{imagen_b64}"}},
                ]},
            ], max_tokens=45, temperature=0.2, timeout=30,
        )
        descripcion = " ".join(str(respuesta.choices[0].message.content or "").split())[:150]
        if not descripcion:
            return None
        tipo = clasificar_descripcion_visual(descripcion)
        memoria["vision"] = {"ultima_descripcion": descripcion, "ultimo_tipo": tipo, "ultima_fecha": ahora_iso()}
        sumar_estadistica(memoria, "analisis_visual")
        sumar_estadistica(memoria, "objetos_vistos")
        if tipo == "animal": sumar_estadistica(memoria, "animales_vistos")
        elif tipo == "persona": sumar_estadistica(memoria, "personas_vistas_ia")
        recordar(memoria, f"vision_{tipo}", descripcion)
        guardar_memoria(memoria)
        print(f"Vision IA ({tipo}): {descripcion}")
        return descripcion
    except Exception as error:
        print("Vision IA omitida:", error)
        return None

def lanzar_vision(imagen_b64, memoria, resultados, vision_ocupada):
    if not USAR_IA_VISION or client is None or vision_ocupada.is_set(): return
    vision_ocupada.set()
    def tarea():
        try:
            descripcion = analizar_imagen_ia(imagen_b64, memoria)
            if descripcion: resultados.put(descripcion)
        finally:
            vision_ocupada.clear()
    threading.Thread(target=tarea, daemon=True).start()

# ---------------------- MOVIMIENTOS --------------------------

def ojos(robot, estado):
    try:
        hue, saturacion = COLORES.get(estado, COLORES["tranquilo"])
        robot.behavior.set_eye_color(hue=hue, saturation=saturacion)
    except Exception:
        pass


def cabeza(robot, grados, lento=False):
    try:
        robot.behavior.set_head_angle(
            degrees(max(-20, min(40, grados))),
            max_speed=6.0 if lento else 12.0,
            accel=6.0 if lento else 12.0,
        )
    except Exception:
        pass


def brazo(robot, altura, lento=False):
    try:
        robot.behavior.set_lift_height(
            max(0.0, min(1.0, altura)),
            max_speed=6.0 if lento else 12.0,
            accel=6.0 if lento else 12.0,
        )
    except Exception:
        pass


def girar(robot, grados):
    try:
        robot.behavior.turn_in_place(degrees(grados))
        return True
    except Exception:
        return False


def gesto_saludo(robot):
    ojos(robot, "feliz")
    animar(robot, "saludo")
    cabeza(robot, 30)
    brazo(robot, 0.45)
    time.sleep(0.16)
    brazo(robot, 0.12)
    time.sleep(0.12)
    brazo(robot, 0.45)
    time.sleep(0.16)
    brazo(robot, 0.0)
    cabeza(robot, 18)


def gesto_curioso(robot, giro=True):
    ojos(robot, "curioso")
    animar(robot, "curioso")
    brazo(robot, 0.10)
    cabeza(robot, 38)

    if giro:
        girar(robot, random.choice([-18, 18, -24, 24]))

    cabeza(robot, -8)
    time.sleep(0.16)
    cabeza(robot, 26)


def gesto_feliz(robot):
    ojos(robot, "feliz")
    animar(robot, "feliz")
    cabeza(robot, 28)
    brazo(robot, 0.30)
    girar(robot, -16)
    girar(robot, 32)
    girar(robot, -16)
    brazo(robot, 0.0)


def gesto_sorpresa(robot):
    ojos(robot, "sorprendido")
    animar(robot, "sorpresa")
    cabeza(robot, 40)
    brazo(robot, 0.58)
    time.sleep(0.18)
    brazo(robot, 0.10)


def gesto_protesta(robot):
    ojos(robot, "enfadado")
    animar(robot, "enfadado")
    cabeza(robot, -10)
    brazo(robot, 0.68)
    time.sleep(0.18)
    brazo(robot, 0.15)
    girar(robot, random.choice([-28, 28]))
    brazo(robot, 0.0)


def gesto_descanso(robot):
    ojos(robot, "tranquilo")
    cabeza(robot, 12, lento=True)
    brazo(robot, 0.0, lento=True)


def gesto_carino(robot):
    ojos(robot, "amoroso")
    animar(robot, "carino")
    cabeza(robot, 8, lento=True)
    brazo(robot, 0.05, lento=True)


# ------------------------- SENSORES --------------------------

def distancia_frontal(robot):
    try:
        lectura = robot.proximity.last_valid_sensor_reading

        if lectura and lectura.distance:
            return lectura.distance.distance_mm

    except Exception:
        pass

    return None


def hay_obstaculo(robot, limite=DISTANCIA_FRENO_MM):
    distancia = distancia_frontal(robot)
    return distancia is not None and distancia < limite


def borde_detectado(robot):
    try:
        return bool(robot.status.is_cliff_detected)
    except Exception:
        return False


def esta_cayendo(robot):
    try:
        return bool(robot.status.is_falling)
    except Exception:
        return False


def esta_levantado(robot):
    try:
        return bool(
            robot.status.is_being_held
            or robot.status.is_picked_up
        )
    except Exception:
        return False


def tiene_control(robot):
    try:
        return bool(robot.conn.requires_behavior_control)
    except Exception:
        return True


def tocar_robot(robot):
    try:
        lectura = robot.touch.last_sensor_reading
        return bool(lectura and lectura.is_being_touched)
    except Exception:
        return False


def vector_acelerometro(robot):
    try:
        a = robot.accel
        return (float(a.x), float(a.y), float(a.z))
    except Exception:
        return None


def cambio_acelerometro(anterior, actual):
    if anterior is None or actual is None:
        return 0.0

    return math.sqrt(
        (actual[0] - anterior[0]) ** 2
        + (actual[1] - anterior[1]) ** 2
        + (actual[2] - anterior[2]) ** 2
    )


def bateria_baja(robot):
    try:
        estado = robot.get_battery_state()
        return bool(estado and estado.battery_volts <= VOLTAJE_BATERIA_BAJA)
    except Exception:
        return False


def esta_en_cargador(robot):
    try:
        return bool(robot.status.is_on_charger)
    except Exception:
        return False


# -------------------------- CUBO -----------------------------

def obtener_cubo(robot):
    try:
        cubo = robot.world.connected_light_cube

        if cubo and cubo.is_connected:
            return cubo

    except Exception:
        pass

    return None


def conectar_cubo(robot):
    try:
        robot.world.connect_cube()
        time.sleep(2)
        return obtener_cubo(robot) is not None
    except Exception:
        return False


def docking_con_cubo(robot, resultados, ia_ocupada):
    cubo = obtener_cubo(robot)

    if not cubo:
        return False

    try:
        ojos(robot, "jugueton")
        cabeza(robot, -5)
        brazo(robot, 0.0)
        lanzar_ia("docking", resultados, ia_ocupada)

        resultado = robot.behavior.dock_with_cube(cubo, num_retries=2)

        if resultado and resultado.success:
            gesto_feliz(robot)
            return True

    except Exception as error:
        print("Docking omitido:", error)

    return False


def jugar_cubo(robot, resultados, ia_ocupada):
    if not obtener_cubo(robot):
        return False

    try:
        ojos(robot, "jugueton")
        gesto_feliz(robot)
        lanzar_ia("cubo", resultados, ia_ocupada)
        robot.behavior.roll_visible_cube()
        return True

    except Exception as error:
        print("Juego con cubo omitido:", error)
        return False


# ------------------- EXPLORACION PRUDENTE --------------------

def avanzar_seguro(robot, distancia_total, rapido=False):
    recorrido = 0
    velocidad = VELOCIDAD_RAPIDA_MMPS if rapido else VELOCIDAD_NORMAL_MMPS

    while recorrido < distancia_total:
        if borde_detectado(robot) or esta_levantado(robot):
            return False

        distancia = distancia_frontal(robot)

        if distancia is None or distancia < DISTANCIA_FRENO_MM:
            return False

        tramo = min(TRAMO_AVANCE_MM, distancia_total - recorrido)

        try:
            robot.behavior.drive_straight(
                distance_mm(tramo),
                speed_mmps(velocidad),
                should_play_anim=True,
            )
        except Exception:
            return False

        recorrido += tramo

    return True


def registrar_obstaculo(obstaculos):
    ahora = time.time()
    obstaculos.append(ahora)

    while obstaculos and ahora - obstaculos[0] > VENTANA_OBSTACULOS_SEGUNDOS:
        obstaculos.popleft()


def modo_prudente(obstaculos):
    return len(obstaculos) >= MAX_OBSTACULOS_RECIENTES


def observar_entorno(robot):
    ojos(robot, "curioso")
    brazo(robot, 0.08)
    cabeza(robot, 37)
    time.sleep(0.12)
    cabeza(robot, 12)
    time.sleep(0.12)
    cabeza(robot, -10)
    time.sleep(0.12)
    cabeza(robot, 24)


def escapar_de_peligro(robot):
    gesto_sorpresa(robot)
    girar(robot, random.choice([-130, -110, 110, 130]))
    cabeza(robot, 25)


def seguir_cara_continuo(robot, cara):
    try:
        robot.behavior.turn_towards_face(cara)
        return True
    except Exception:
        return False


def explorar(robot, obstaculos, energia, curiosidad):
    if borde_detectado(robot):
        return "borde"

    if hay_obstaculo(robot):
        registrar_obstaculo(obstaculos)
        escapar_de_peligro(robot)
        return "obstaculo"

    if modo_prudente(obstaculos):
        observar_entorno(robot)
        girar(robot, random.choice([-55, 55, -70, 70]))
        return "prudente"

    acciones = ["mirar", "curva", "avanzar", "zigzag", "jugar"]
    pesos = [
        22 + curiosidad,
        22,
        24 + energia,
        14,
        8 + curiosidad / 2,
    ]

    accion = random.choices(acciones, weights=pesos, k=1)[0]

    if accion == "mirar":
        gesto_curioso(robot)
        return "mirar"

    if accion == "curva":
        observar_entorno(robot)
        girar(robot, random.choice([-48, -38, 38, 48]))
        avanzar_seguro(robot, random.choice([30, 42, 54]))
        return "curva"

    if accion == "avanzar":
        observar_entorno(robot)
        avanzar_seguro(
            robot,
            random.choice([36, 48, 60]),
            rapido=energia > 70,
        )
        return "avanzar"

    if accion == "zigzag":
        girar(robot, random.choice([-25, 25]))

        if avanzar_seguro(robot, 30):
            girar(robot, random.choice([-30, 30]))
            avanzar_seguro(robot, 24)

        return "zigzag"

    gesto_feliz(robot)
    return "jugar"


def salir_del_cargador(robot):
    try:
        if esta_en_cargador(robot):
            robot.behavior.drive_off_charger()
            time.sleep(1)
            gesto_feliz(robot)
            decir(robot, "Ya estoy listo para explorar")
            return True
    except Exception as error:
        print("No pudo salir del cargador:", error)

    return False


def volver_al_cargador(robot):
    try:
        ojos(robot, "cansado")
        cabeza(robot, -10, lento=True)
        decir(robot, "Necesito encontrar mi cargador")
        robot.behavior.drive_on_charger()
        return True
    except Exception as error:
        print("Cargador no encontrado:", error)
        return False


def esperar_recuperar_control(robot, limite_segundos=SEGUNDOS_ESPERA_CONTROL):
    inicio = time.time()

    while not tiene_control(robot):
        if time.time() - inicio > limite_segundos:
            return False

        time.sleep(0.3)

    return True


# -------------------------- PROGRAMA -------------------------

def main():
    memoria = cargar_memoria()
    sumar_estadistica(memoria, "sesiones")
    recordar(memoria, "inicio", "Inicio de una nueva sesion")
    guardar_memoria(memoria)

    caras_saludadas = set()
    obstaculos_recientes = deque()
    resultados_ia = queue.Queue()
    resultados_vision = queue.Queue()
    ia_ocupada = threading.Event()
    vision_ocupada = threading.Event()

    inicio_tacto = None
    ultima_caricia = 0
    ultimo_levantado = 0
    ultima_sacudida = 0
    ultimo_obstaculo = 0
    ultimo_borde = 0
    ultima_bateria = 0
    ultimo_saludo_cara = 0
    ultimo_guardado_memoria = time.time()
    ultima_vision = 0

    muestra_acelerometro_anterior = None
    cara_actual = None

    energia = 72
    curiosidad = 65
    afecto = 40

    with anki_vector.Robot(
        enable_face_detection=True,
        estimate_facial_expression=True,
        enable_nav_map_feed=ACTIVAR_MAPA_SDK,
        show_viewer=SHOW_CAMERA,
        show_3d_viewer=SHOW_MAPA_3D,
    ) as robot:

        print("Conectando sensores...")
        print("Memoria:", ARCHIVO_MEMORIA)

        try:
            robot.camera.init_camera_feed()
            print("Camara activa: Vector puede detectar caras.")
        except Exception as error:
            print("Camara no disponible:", error)

        def al_ver_cara(robot_evt, event_type, event):
            nonlocal cara_actual

            try:
                cara_actual = event.face
            except Exception:
                pass

        def al_ver_objeto(robot_evt, event_type, event):
            try:
                nombre = type(event.obj).__name__
                print("Objeto observado:", nombre)
            except Exception:
                pass

        try:
            robot.events.subscribe(al_ver_cara, Events.robot_observed_face)
        except Exception as error:
            print("Evento de cara no disponible:", error)

        if OBJETOS_PERSONALIZADOS:
            try:
                robot.events.subscribe(al_ver_objeto, Events.object_appeared)
                print("Eventos de objetos personalizados activados.")
            except Exception as error:
                print("Eventos de objetos no disponibles:", error)

        if conectar_cubo(robot):
            print("Cubo conectado.")
        else:
            print("Cubo no conectado: seguira explorando sin cubo.")

        if esta_en_cargador(robot):
            salir_del_cargador(robot)

        ojos(robot, "feliz")
        cabeza(robot, 24)
        brazo(robot, 0.0)
        gesto_saludo(robot)
        decir(robot, random.choice(FRASES["inicio"]))

        print(
            "Memoria actual:",
            memoria["estadisticas"]["sesiones"], "sesiones;",
            memoria["estadisticas"]["caricias"], "caricias;",
            memoria["estadisticas"]["exploraciones"], "exploraciones.",
        )

        proximo_paseo = time.time() + 3
        proximo_juego = time.time() + random.randint(80, 135)
        proximo_docking = time.time() + random.randint(150, 240)
        proxima_frase = time.time() + random.randint(85, 145)
        proximo_descanso = time.time() + random.randint(120, 185)

        print("Vector 4.0 activo. Pulsa Ctrl+C para detener.")

        try:
            while True:
                ahora = time.time()

                if not tiene_control(robot):
                    print("Control perdido: esperando recuperacion...")
                    recuperado = esperar_recuperar_control(robot)

                    if not recuperado:
                        time.sleep(1.0)
                        continue

                    print("Control recuperado.")
                    proximo_paseo = time.time() + 4
                    continue

                levantado = esta_levantado(robot)

                try:
                    frase_lista = resultados_ia.get_nowait()

                    if not levantado and not borde_detectado(robot):
                        decir(robot, frase_lista)
                        proximo_paseo = time.time() + 3

                except queue.Empty:
                    pass

                try:
                    descripcion_visual = resultados_vision.get_nowait()
                    if not levantado and not borde_detectado(robot):
                        gesto_curioso(robot, giro=False)
                        decir(robot, descripcion_visual)
                        proximo_paseo = time.time() + 4
                except queue.Empty:
                    pass

                if esta_cayendo(robot):
                    print("PELIGRO: Vector informa que esta cayendo.")
                    recordar_y_guardar(
                        memoria,
                        "caida",
                        "Vector informo de una posible caida",
                    )
                    proximo_paseo = time.time() + 12
                    time.sleep(0.25)
                    continue

                if borde_detectado(robot):
                    proximo_paseo = time.time() + 8

                    if ahora - ultimo_borde > 25:
                        ultimo_borde = ahora
                        recordar_y_guardar(
                            memoria,
                            "borde",
                            "Vector detuvo exploracion al detectar un borde",
                            "bordes",
                        )
                        ojos(robot, "sorprendido")
                        cabeza(robot, 35)
                        brazo(robot, 0.18)
                        decir(robot, random.choice(FRASES["borde"]))

                    time.sleep(0.25)
                    continue

                if levantado:
                    if ahora - ultimo_levantado > 12:
                        ultimo_levantado = ahora
                        recordar_y_guardar(
                            memoria,
                            "levantado",
                            "Vector fue levantado del suelo",
                            "levantado",
                        )
                        gesto_sorpresa(robot)
                        decir(robot, random.choice(FRASES["levantado"]))

                    proximo_paseo = time.time() + 4
                    time.sleep(0.18)
                    continue

                try:
                    caras = robot.world.visible_faces

                    if caras:
                        cara = caras[0]
                        cara_actual = cara
                        seguir_cara_continuo(robot, cara)
                        curiosidad = min(100, curiosidad + 1)

                        if (
                            cara.face_id not in caras_saludadas
                            and ahora - ultimo_saludo_cara > 45
                        ):
                            caras_saludadas.add(cara.face_id)
                            ultimo_saludo_cara = ahora

                            persona = registrar_persona(memoria, cara)
                            recordar_y_guardar(
                                memoria,
                                "cara",
                                f"Vio a {persona['nombre']}",
                                "caras_saludadas",
                            )

                            gesto_saludo(robot)

                            if getattr(cara, "name", None):
                                lanzar_ia(
                                    "persona",
                                    resultados_ia,
                                    ia_ocupada,
                                )
                            else:
                                lanzar_ia(
                                    "persona_nueva",
                                    resultados_ia,
                                    ia_ocupada,
                                )

                            proximo_paseo = time.time() + 4

                except Exception:
                    pass

                tocando = tocar_robot(robot)

                if tocando and inicio_tacto is None:
                    inicio_tacto = ahora

                if not tocando and inicio_tacto is not None:
                    duracion = ahora - inicio_tacto
                    inicio_tacto = None

                    if ahora - ultima_caricia > 6:
                        ultima_caricia = ahora
                        curiosidad = min(100, curiosidad + 8)
                        energia = min(100, energia + 4)
                        afecto = min(100, afecto + 10)

                        recordar_y_guardar(
                            memoria,
                            "caricia",
                            f"Caricia de {duracion:.1f} segundos",
                            "caricias",
                        )

                        if duracion >= 2.0:
                            recordar_y_guardar(
                                memoria,
                                "caricia_larga",
                                "Vector recibio una caricia larga",
                                "caricias_largas",
                            )
                            gesto_carino(robot)
                            decir(
                                robot,
                                random.choice(FRASES["caricia_larga"]),
                            )

                        elif duracion >= 1.0:
                            gesto_feliz(robot)
                            decir(robot, random.choice(FRASES["caricia"]))

                        else:
                            gesto_saludo(robot)
                            lanzar_ia("caricia", resultados_ia, ia_ocupada)

                        proximo_paseo = time.time() + 3

                muestra_actual = vector_acelerometro(robot)
                cambio = cambio_acelerometro(
                    muestra_acelerometro_anterior,
                    muestra_actual,
                )
                muestra_acelerometro_anterior = muestra_actual

                if cambio > 7000 and ahora - ultima_sacudida > 30:
                    ultima_sacudida = ahora
                    recordar_y_guardar(
                        memoria,
                        "sacudida",
                        "Vector detecto un movimiento brusco",
                        "sacudidas",
                    )
                    gesto_protesta(robot)
                    decir(robot, random.choice(FRASES["movido"]))
                    proximo_paseo = time.time() + 4

                if hay_obstaculo(robot) and ahora - ultimo_obstaculo > 9:
                    ultimo_obstaculo = ahora
                    registrar_obstaculo(obstaculos_recientes)
                    recordar_y_guardar(
                        memoria,
                        "obstaculo",
                        "Vector encontro un obstaculo frontal",
                        "obstaculos",
                    )
                    curiosidad = min(100, curiosidad + 3)
                    gesto_sorpresa(robot)
                    lanzar_ia("obstaculo", resultados_ia, ia_ocupada)
                    escapar_de_peligro(robot)
                    proximo_paseo = time.time() + 3

                if bateria_baja(robot) and ahora - ultima_bateria > 300:
                    ultima_bateria = ahora
                    energia = 10
                    recordar_y_guardar(
                        memoria,
                        "bateria_baja",
                        "Vector detecto bateria baja",
                    )

                    if CARGA_AUTOMATICA and not esta_en_cargador(robot):
                        volver_al_cargador(robot)
                        proximo_paseo = time.time() + 45

                if modo_prudente(obstaculos_recientes):
                    if ahora - ultimo_obstaculo > 12:
                        ultimo_obstaculo = ahora
                        ojos(robot, "curioso")
                        decir(robot, random.choice(FRASES["prudente"]))
                        proximo_paseo = time.time() + 5

                if (
                    ahora >= proximo_paseo
                    and not esta_en_cargador(robot)
                    and not bateria_baja(robot)
                ):
                    resultado = explorar(
                        robot,
                        obstaculos_recientes,
                        energia,
                        curiosidad,
                    )

                    recordar_y_guardar(
                        memoria,
                        "exploracion",
                        f"Accion autonoma: {resultado}",
                        "exploraciones",
                    )

                    if resultado in ("avanzar", "curva", "zigzag"):
                        energia = max(15, energia - 3)
                        curiosidad = max(20, curiosidad - 2)
                    else:
                        curiosidad = min(100, curiosidad + 1)

                    proximo_paseo = time.time() + random.uniform(2.4, 4.5)

                if (
                    DOCKING_CON_CUBO
                    and ahora >= proximo_docking
                    and not esta_en_cargador(robot)
                ):
                    if docking_con_cubo(robot, resultados_ia, ia_ocupada):
                        recordar_y_guardar(
                            memoria,
                            "docking_cubo",
                            "Vector alineo su gancho con el cubo",
                            "dockings_cubo",
                        )
                        energia = max(15, energia - 6)
                        curiosidad = min(100, curiosidad + 12)

                    proximo_docking = time.time() + random.randint(180, 280)
                    proximo_paseo = time.time() + 5

                if (
                    JUGAR_CON_CUBO
                    and ahora >= proximo_juego
                    and not esta_en_cargador(robot)
                ):
                    if jugar_cubo(robot, resultados_ia, ia_ocupada):
                        recordar_y_guardar(
                            memoria,
                            "juego_cubo",
                            "Vector jugo con el cubo",
                            "juegos_cubo",
                        )
                        energia = max(15, energia - 5)
                        curiosidad = min(100, curiosidad + 10)

                    proximo_juego = time.time() + random.randint(120, 200)
                    proximo_paseo = time.time() + 5

                if (
                    ahora - ultima_vision >= INTERVALO_VISION_SEGUNDOS
                    and not levantado and not esta_en_cargador(robot)
                    and not borde_detectado(robot) and not vision_ocupada.is_set()
                ):
                    ultima_vision = ahora
                    observar_entorno(robot)
                    imagen_b64 = capturar_imagen_base64(robot)
                    if imagen_b64:
                        lanzar_vision(imagen_b64, memoria, resultados_vision, vision_ocupada)

                if ahora >= proxima_frase:
                    gesto_curioso(robot)
                    lanzar_ia("explorar", resultados_ia, ia_ocupada)
                    proxima_frase = time.time() + random.randint(120, 190)
                    proximo_paseo = time.time() + 3

                if ahora >= proximo_descanso:
                    gesto_descanso(robot)
                    recordar_y_guardar(
                        memoria,
                        "descanso",
                        "Vector hizo una pausa de descanso",
                        "descansos",
                    )
                    lanzar_ia("descanso", resultados_ia, ia_ocupada)
                    energia = min(100, energia + 12)
                    curiosidad = min(100, curiosidad + 4)
                    time.sleep(random.uniform(1.2, 2.4))
                    proximo_descanso = time.time() + random.randint(150, 230)

                if ahora - ultimo_guardado_memoria >= INTERVALO_GUARDADO_MEMORIA:
                    guardar_memoria(memoria)
                    ultimo_guardado_memoria = ahora

                time.sleep(0.18)

        finally:
            recordar(memoria, "fin", "Fin de sesion de Vector")
            guardar_memoria(memoria)

            try:
                robot.events.unsubscribe(
                    al_ver_cara,
                    Events.robot_observed_face,
                )
            except Exception:
                pass


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Deteniendo Vector 4.0...")